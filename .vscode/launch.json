{
  // F5: runs "Build QLaunch" first, then starts debugging. Needs the C/C++ extension (ms-vscode.cpptools).
  // Debugs the exe built by the preset selected in the status bar (Debug or Release).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug QLaunch",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "stopAtEntry": false,
      // Working folder = exe folder: settings, data, languages and skins all live next to the exe
      "cwd": "${command:cmake.launchTargetDirectory}",
      "environment": [],
      "console": "internalConsole",
      "preLaunchTask": "Build QLaunch"
    },
    {
      // The app normally runs hidden in the background; attach to it when it is already running
      "name": "Attach to QLaunch.exe",
      "type": "cppvsdbg",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
